# Copy this file to .env.local and replace these with YOUR OWN values.
# NEVER push .env.local or passwords to GitHub.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
ADMIN_EMAIL="operator@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"
ADMIN_SESSION_SECRET="REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_SESSION_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_SECRET"
